# Database — local SQLite file for dev; use a Turso/libSQL URL in staging/prod
DATABASE_URL=file:./data/pandafit.db
DATABASE_AUTH_TOKEN=

# Session signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=change-me-to-a-long-random-string

# AI plan generation (server-side only — never exposed to the browser or mobile apps)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_TIMEOUT_MS=25000

# Public base URL (used in password-reset links)
APP_URL=http://localhost:3000

# Email — console (default: prints emails to server logs) | resend | sendgrid
EMAIL_PROVIDER=console
EMAIL_FROM=PandaFit <no-reply@pandafit.app>
RESEND_API_KEY=
SENDGRID_API_KEY=

# Browser push — generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Protects POST /api/cron/reminders (called every 5 min by the scheduler)
CRON_SECRET=change-me-too
